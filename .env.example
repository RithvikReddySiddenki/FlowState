# Copy to apps/api/.env. Never commit actual credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://flowstate:local-password@localhost:5432/flowstate
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Generate separately with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379/0
